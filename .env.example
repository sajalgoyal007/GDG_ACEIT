# Optional for the demo provider; both are required for Supabase-backed data/admin.
# Supabase project Settings > API. The publishable key is safe for browser use;
# access is still restricted by PostgreSQL grants and RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never prefix the service-role key with NEXT_PUBLIC_. Keep it server-only.
# Needed only for authenticated participant lookup and isolated worker RPCs.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# No authorized Google Skills live-data provider is available. Keep false.
# Enabling this flag alone cannot activate the provider; it fails closed.
AUTO_PROGRESS_ENABLED=false

# Only used if an approved provider and a supported scheduled trigger are configured.
# Vercel sends this value as Authorization: Bearer <CRON_SECRET> to the Cron route.
CRON_SECRET=replace_with_random_server_only_cron_secret

# Google Form response sync: server-only settings; never prefix these with NEXT_PUBLIC_.
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_spreadsheet_id
GOOGLE_SHEETS_TAB_NAME=Form Responses 1
GOOGLE_SHEETS_HEADER_ROW=1
# Confirm and set these to the exact header cell text in the private response sheet.
GOOGLE_SHEETS_NAME_HEADER=Name
GOOGLE_SHEETS_EMAIL_HEADER=Email
GOOGLE_SHEETS_PROFILE_URL_HEADER=Google Skills profile URL
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace_with_service_account_email
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=replace_with_service_account_private_key
# Generate a random secret of at least 32 bytes; do not reuse a password.
PARTICIPANT_MATCH_HMAC_SECRET=replace_with_32_byte_or_longer_random_secret
